@model CafeMenuManager.Model.Ingredient

<h1>Ingredient Details</h1>

<p><strong>Name:</strong> @Model.Name</p>

<h4>Used In Menu Items</h4>

@if (Model.MenuItems != null)
{
    <ul>
        @foreach (var item in Model.MenuItems)
        {
            <li>@item.Name</li>
        }
    </ul>
}

<a asp-action="Edit" asp-route-id="@Model.IngredientId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>