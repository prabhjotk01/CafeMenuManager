@model IEnumerable<CafeMenuManager.Model.Ingredient>

<h1>Ingredients</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Ingredient</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Menu Items</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ingredient in Model)
        {
            <tr>
                <td>@ingredient.Name</td>
                <td>@ingredient.MenuItems?.Count()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ingredient.IngredientId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@ingredient.IngredientId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@ingredient.IngredientId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>