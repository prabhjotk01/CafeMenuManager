@model IEnumerable<CafeMenuManager.Model.MenuItem>

<h1>Menu Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Menu Item</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>$@item.Price</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MenuItemId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.MenuItemId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.MenuItemId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>