@model IEnumerable<CafeMenuManager.Model.Category>

<h1>Categories</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Menu Items</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.MenuItems?.Count()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@category.CategoryId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@category.CategoryId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@category.CategoryId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>